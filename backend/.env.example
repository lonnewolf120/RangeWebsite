# Local (non-Docker) development only. Copy to backend/.env.
# Assumes a throwaway local Postgres, e.g.:
#   docker run -d --name rangewebsite-test-db -e POSTGRES_USER=test \
#     -e POSTGRES_PASSWORD=test -e POSTGRES_DB=rangewebsite_test \
#     -p 5434:5432 postgres:16-alpine

PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://test:test@localhost:5434/rangewebsite_test
JWT_SECRET=a-local-development-secret-change-in-production

# Must match database/.env.example — both packages seed/read the same
# bootstrap admin account.
ADMIN_BOOTSTRAP_EMAIL=admin@cyberrange.test
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
