# ---------------------------------------------------------------------------
# Docker Compose (docker compose up) reads this file directly from the repo
# root. Copy it to `.env` and adjust before running.
# ---------------------------------------------------------------------------

# Postgres (the `db` service creates its database with these on first boot)
POSTGRES_USER=rangewebsite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rangewebsite

# Backend
JWT_SECRET=change-me-to-a-random-64-char-string
CORS_ORIGIN=http://localhost:3000

# Seeded once into the AdminUser table by database/prisma/seed.ts
ADMIN_BOOTSTRAP_EMAIL=admin@cyberrange.test
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# Frontend: server-only var read inside Server Components (never sent to
# the browser), so it's fine for this to be the internal Compose network
# address rather than a host-reachable one.
BACKEND_URL=http://backend:4000

# ---------------------------------------------------------------------------
# Local (non-Docker) development note: running `npm run dev` at the repo
# root, plus `backend/` and `database/` directly with Postgres on the host,
# uses separate `backend/.env` / `database/.env` files instead (DATABASE_URL
# pointing at e.g. postgresql://test:test@localhost:5434/rangewebsite_test,
# and BACKEND_URL=http://localhost:4000 in the root .env). Those are
# gitignored and not covered by this Compose-focused example file.
# ---------------------------------------------------------------------------
