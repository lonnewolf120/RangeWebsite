# ---------------------------------------------------------------------------
# Docker Compose (docker compose up) reads this file directly from the repo
# root. Copy it to `.env` and fill in every value marked REQUIRED before
# deploying anywhere but a local machine — none of these have safe defaults.
#
#   cp .env.example .env
#   # generate strong secrets instead of typing your own:
#   openssl rand -hex 32   # -> JWT_SECRET
#   openssl rand -hex 20   # -> POSTGRES_PASSWORD
# ---------------------------------------------------------------------------

# Postgres (the `db` service creates its database with these on first boot;
# changing them after the volume already exists does NOT change the DB
# password — you'd need to do that in Postgres itself or reset the volume).
POSTGRES_USER=rangewebsite
POSTGRES_PASSWORD=REQUIRED-generate-with-openssl-rand--hex-20
POSTGRES_DB=rangewebsite

# Backend
# REQUIRED: signs every admin JWT. Anyone with this can forge admin tokens.
JWT_SECRET=REQUIRED-generate-with-openssl-rand--hex-32
# REQUIRED for production: the exact public origin the frontend is served
# from (e.g. https://cyberrange.mist.ac.bd). Requests from any other origin
# are rejected by the backend's CORS policy.
CORS_ORIGIN=http://localhost:3412

# Bootstrap admin account, created once by database/prisma/seed.ts if it
# doesn't already exist. REQUIRED: pick your own password — this is a login
# credential, not an infrastructure secret, so it isn't something to
# auto-generate blindly. Log in and this is the account you'll use until an
# admin UI to manage additional accounts exists.
ADMIN_BOOTSTRAP_EMAIL=admin@cyberrange.test
ADMIN_BOOTSTRAP_PASSWORD=REQUIRED-set-your-own-strong-password

# Frontend: server-only var read inside Server Components (never sent to
# the browser), so it's fine for this to be the internal Compose network
# address rather than a host-reachable one. No change needed unless you
# rename the `backend` service in docker-compose.yml.
BACKEND_URL=http://backend:5412

# ---------------------------------------------------------------------------
# Local (non-Docker) development note: running `npm run dev` at the repo
# root, plus `backend/` and `database/` directly against Postgres on the
# host, uses separate `backend/.env.example` / `database/.env.example`
# instead. Those files are for a throwaway local dev database, not this
# Compose-managed production one.
# ---------------------------------------------------------------------------
